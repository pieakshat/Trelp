# Live vault the app reads. Addresses come from contracts/deployments/<network>.json.
TRELP_CHAIN_ID=84532
TRELP_VAULT_ADDRESS=0x30c7e0f03A97E982AfEc1b90084363B5EDA2B5a6
TRELP_DEPLOYMENT_BLOCK=46770386
# Use your own RPC. A public endpoint will rate limit under normal use.
TRELP_RPC_URL=https://base-sepolia-rpc.publicnode.com
# Log queries. Alchemy free tier caps eth_getLogs to 10 blocks, so point this elsewhere.
TRELP_LOGS_RPC_URL=https://base-sepolia-rpc.publicnode.com
TRELP_VAULT_ID=trelp-base-sepolia

# Wallet connection. Without an app id the UI stays read-only.
NEXT_PUBLIC_PRIVY_APP_ID=cmtzvjwdt03350dl23cueklay
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# Show a mint button on the deposit panel. Test tokens only.
NEXT_PUBLIC_TRELP_FAUCET=true
